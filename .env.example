# ======================
# Silicon Valley Builder
# ======================

# Database
DATABASE_URL="postgresql://svb:svb_secret@localhost:5432/svb?schema=public"
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-openssl-rand-base64-32"

# First Admin (created on seed)
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="Admin123!ChangeMe"

# Domain (for production Caddy)
DOMAIN="localhost"

# ======================
# LLM Providers (at least one required)
# ======================
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

GROQ_API_KEY=""
XAI_API_KEY=""
DEEPSEEK_API_KEY=""
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# Default model (can be overridden in admin)
DEFAULT_MODEL="gpt-4o-mini"

# ======================
# Stripe
# ======================
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""

# ======================
# Git OAuth (optional)
# ======================
GITHUB_ID=""
GITHUB_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
BITBUCKET_CLIENT_ID=""
BITBUCKET_CLIENT_SECRET=""

# ======================
# Encryption for stored API keys
# ======================
ENCRYPTION_KEY="32-byte-hex-or-base64-key-change-me"

# ======================
# App
# ======================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
